{
  "name": "meadowstead",
  "version": "1.0.0",
  "private": true,
  "description": "Meadowstead — a cozy turn-based homestead: plant, water, harvest, craft and fulfil orders, on the StarHermit engine.",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node --test tests/rules.test.js tests/save.test.mjs tests/i18n.test.mjs",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "plays": "node tools/gen-plays.mjs",
    "textures": "node tools/bake-textures.mjs",
    "start": "node server.js"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
